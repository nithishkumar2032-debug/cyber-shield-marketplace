# Cyber Shield Pan-India B2B Crop Marketplace
# Environment Configuration Blueprint

# Next.js App
NEXT_PUBLIC_APP_NAME="Pan-India B2B Crop Marketplace"
NEXT_PUBLIC_APP_ATTRIBUTION="Prepared by Cyber Shield"

# Supabase (PostgreSQL, Authentication & Protected Storage)
# Optional in local standalone mode; required for hosted cloud deployment:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API (For AI Help Chatbot)
# If omitted, the chatbot runs using the built-in verified FAQ knowledge engine:
GEMINI_API_KEY=your-gemini-api-key

# SMS Gateway Integration (Optional - simulated link provided in development):
SMS_GATEWAY_API_KEY=your-sms-api-key
